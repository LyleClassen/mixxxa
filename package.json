{
  "name": "mixxxa-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Mixxxa workspace root — orchestration only; nothing here is published or imported",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "go": "bun install && bun run setup:python && bun run dev:hmr",
    "setup:python": "bun run --filter @mixxxa/sidecar setup",
    "build:sidecar": "bun run --filter @mixxxa/sidecar build",
    "dev": "bun run --filter mixxxa dev",
    "dev:hmr": "bun run --filter mixxxa dev:hmr",
    "hmr": "bun run --filter mixxxa hmr",
    "start": "bun run --filter mixxxa start",
    "build:canary": "bun run build:sidecar && bun run --filter mixxxa build:canary",
    "sandbox:bitnet": "bun run --filter mixxxa sandbox:bitnet"
  },
  "patchedDependencies": {
    "rbox-js@0.1.7": "patches/rbox-js@0.1.7.patch",
    "@unimusic/chromaprint@0.1.4": "patches/@unimusic%2Fchromaprint@0.1.4.patch"
  },
  "trustedDependencies": [
    "@kmamal/gpu",
    "webgpu",
    "ffmpeg-static",
    "ffprobe-static"
  ]
}
