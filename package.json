{
  "name": "electrobun-react-tailwind-vite",
  "version": "1.0.0",
  "description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
  "scripts": {
    "go": "bun install && uv sync --project sidecar && bun run dev:hmr",
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "setup:python": "uv sync --project sidecar",
    "build:sidecar": "uv run --project sidecar pyinstaller sidecar/build.spec --distpath sidecar/dist --workpath sidecar/build_work",
    "build:canary": "bun run build:sidecar && vite build && electrobun build --env=canary",
    "sandbox:bitnet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bitnet-sandbox.ts"
  },
  "dependencies": {
    "0xbitnet": "^0.5.2",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@types/ffprobe-static": "^2.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.18.1",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.17.0",
    "material-react-table": "^3.2.1",
    "rbox-js": "^0.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "wavesurfer.js": "^7.12.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "webgpu": "^0.4.0"
  },
  "patchedDependencies": {
    "rbox-js@0.1.7": "patches/rbox-js@0.1.7.patch"
  },
  "trustedDependencies": [
    "@kmamal/gpu",
    "webgpu"
  ]
}
